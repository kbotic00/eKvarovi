@page "/djelatnici/novi"
@page "/djelatnici/uredi/{Id:int}"
@rendermode InteractiveServer
@inject HttpClient Http
@inject LookupService Lookups
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@Title - e-Kvarovi</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@Title</MudText>

@if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

<MudPaper Elevation="1" Class="pa-6" Style="max-width: 640px;">
    <MudForm @ref="form" Model="model">
        <MudStack Spacing="3">

            <MudTextField @bind-Value="model.FirstName"
                          Label="Ime"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Ime je obavezno."
                          Immediate="true" />

            <MudTextField @bind-Value="model.LastName"
                          Label="Prezime"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Prezime je obavezno."
                          Immediate="true" />

            <MudTextField @bind-Value="model.Email"
                          Label="E-mail"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Required="true"
                          RequiredError="E-mail je obavezan."
                          Immediate="true" />

            <MudTextField @bind-Value="model.Phone"
                          Label="Telefon"
                          Variant="Variant.Outlined"
                          Immediate="true" />

            <MudTextField @bind-Value="model.JobTitle"
                          Label="Radno mjesto"
                          Variant="Variant.Outlined"
                          Immediate="true" />

            <MudSelect T="int?" @bind-Value="model.LocationId"
                       Label="Matična lokacija"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var location in locations)
                {
                    <MudSelectItem T="int?" Value="@location.Id">@location.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSwitch @bind-Value="model.IsTechnician" Color="Color.Info"
                       Label="Izvršitelj (može mu se dodijeliti radni nalog)" />

            <MudSwitch @bind-Value="model.IsActive" Color="Color.Primary" Label="Aktivan" />

            <MudStack Row="true" Spacing="2">
                <MudButton OnClick="Save"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="isBusy">
                    Spremi
                </MudButton>
                <MudButton Href="/djelatnici" Variant="Variant.Text">Odustani</MudButton>
            </MudStack>

        </MudStack>
    </MudForm>
</MudPaper>

@code {
    [Parameter]
    public int? Id { get; set; }

    private MudForm? form;
    private SaveEmployeeDto model = new();
    private List<LookupDto> locations = new();
    private string? errorMessage;
    private bool isBusy;

    private bool IsEdit => Id.HasValue;

    private string Title => IsEdit ? "Uredi djelatnika" : "Novi djelatnik";

    protected override async Task OnInitializedAsync()
    {
        locations = (await Lookups.GetAsync()).Locations;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsEdit)
        {
            return;
        }

        try
        {
            var employee = await Http.GetFromJsonAsync<EmployeeDto>($"api/employees/{Id}");

            if (employee is not null)
            {
                model = new SaveEmployeeDto
                {
                    FirstName = employee.FirstName,
                    LastName = employee.LastName,
                    Email = employee.Email,
                    Phone = employee.Phone,
                    JobTitle = employee.JobTitle,
                    IsTechnician = employee.IsTechnician,
                    IsActive = employee.IsActive,
                    LocationId = employee.LocationId
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Djelatnika nije moguće učitati: {ex.Message}";
        }
    }

    private async Task Save()
    {
        errorMessage = null;

        if (form is not null)
        {
            await form.ValidateAsync();

            if (!form.IsValid)
            {
                return;
            }
        }

        isBusy = true;

        try
        {
            var response = IsEdit
                ? await Http.PutAsJsonAsync($"api/employees/{Id}", model)
                : await Http.PostAsJsonAsync("api/employees", model);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(IsEdit ? "Promjene su spremljene." : "Djelatnik je dodan.", Severity.Success);
                Navigation.NavigateTo("/djelatnici");
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Spremanje nije uspjelo: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
